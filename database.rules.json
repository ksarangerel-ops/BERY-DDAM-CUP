{
  "rules": {
    "tournaments": {
      "$tournamentId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['teams'])",
        "teams": { ".validate": "newData.hasChildren()" },
        "results": {
          "$match": {
            "$team": {
              "series": { ".validate": "newData.isString() && (newData.val() === '2-0' || newData.val() === '1-1' || newData.val() === '0-2')" },
              "$other": { ".validate": false }
            }
          }
        },
        "updated": { ".validate": "newData.isString()" }
      }
    }
  }
}
