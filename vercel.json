{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/dota2", "destination": "/dota2.html" },
    { "source": "/cs2", "destination": "/cs2.html" },
    { "source": "/games", "destination": "/games.html" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
