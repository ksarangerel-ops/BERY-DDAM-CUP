# Supabase configuration.
# Copy to `.env` and fill in the values from:
#   Supabase dashboard → Project Settings → API
#
# The publishable key is safe to expose in a browser app. Writes are protected
# by Supabase Auth and the RLS policies in `supabase/schema.sql`.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: override the default, separate board ids.
VITE_DOTA_TOURNAMENT_ID=ddam-cup-dota2-final-bracket
VITE_CS2_TOURNAMENT_ID=ddam-cup-cs2-group-final-v1
