# Supabase configuration.
# Copy to `.env` and fill in the values from:
#   Supabase dashboard → Project Settings → API
#
# NOTE: Vite inlines every VITE_* variable into the client bundle at build time.
# These values are visible to anyone who opens the page. That is expected for a
# The anon key is safe to expose in a browser app. Protect writes with the
# Supabase SQL policies in `supabase/schema.sql`, and add auth later if needed.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: lets several organisers share one board, or lets you run a test
# board alongside the real one.
VITE_TOURNAMENT_ID=ddam-cup-dota2-ab-roundrobin
