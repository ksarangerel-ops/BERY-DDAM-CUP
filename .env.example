# Supabase configuration.
# Copy to `.env` and fill in the values from:
#   Supabase dashboard → Project Settings → API
#
# The publishable key is safe to expose in a browser app. Writes are protected
# by Supabase Auth and the RLS policies in `supabase/schema.sql`.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: use a separate board id for rehearsals or another tournament.
VITE_TOURNAMENT_ID=ddam-cup-cs2-final-bracket
